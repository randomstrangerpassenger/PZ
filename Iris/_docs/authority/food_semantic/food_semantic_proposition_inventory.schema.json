{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_class": {
      "enum": [
        "automatic",
        "curated"
      ]
    },
    "fact_axis": {
      "enum": [
        "beverage_property",
        "consumption_form",
        "culinary_role",
        "ingredient_origin",
        "meal_role",
        "preparation_requirement",
        "preparation_state",
        "preservation_form"
      ],
      "type": "string"
    },
    "fact_value": {
      "minLength": 1,
      "type": "string"
    },
    "item_id": {
      "minLength": 1,
      "type": "string"
    },
    "proposition_id": {
      "minLength": 1,
      "type": "string"
    },
    "proposition_license_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_or_approval_lineage_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "proposition_id",
    "fact_axis",
    "fact_value",
    "authority_class",
    "source_or_approval_lineage_id",
    "schema_sha256",
    "proposition_license_sha256"
  ],
  "title": "DVF 3-3 Food Semantic Proposition Inventory",
  "type": "object"
}
