{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"iris-core-refactor-behavior-evidence-v1",
  "type":"object",
  "required":["schema_version","case_id","axis","fixture_id","status","expected","observed","time_axis","owner_change","baseline_denominator_included","subject_commit","subject_tree","subject_worktree_patch_sha256_or_null","producer_base_commit","producer_base_tree","producer_worktree_state","producer_overlay_sha256_or_null","lua_implementation","lua_version","lua_executable_path","lua_version_output","target_runtime_dialect","execution_environment","dialect_sensitive","dialect_reasons","evidence_role","stubbed_dependencies"],
  "properties": {
    "schema_version":{"const":1},
    "case_id":{"type":"string","pattern":"^[a-z0-9._-]+$"},
    "axis":{"type":"string","minLength":1},
    "fixture_id":{"type":"string","minLength":1},
    "status":{"enum":["pass","fail","unvalidated_but_in_scope"]},
    "expected":{},"observed":{},
    "time_axis":{"enum":["pre_refactor_characterization","post_refactor_acceptance"]},
    "owner_change":{"type":"integer","minimum":2,"maximum":6},
    "baseline_denominator_included":{"type":"boolean"},
    "subject_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "subject_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "subject_worktree_patch_sha256_or_null":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "producer_base_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "producer_base_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "producer_worktree_state":{"enum":["clean","tracked_overlay","tracked_and_untracked_overlay"]},
    "producer_overlay_sha256_or_null":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "lua_implementation":{"type":"string","minLength":1},
    "lua_version":{"type":"string","minLength":1},
    "lua_executable_path":{"type":"string"},
    "lua_version_output":{"type":"string","minLength":1},
    "target_runtime_dialect":{"const":"project_zomboid_b41_kahlua"},
    "execution_environment":{"enum":["auxiliary_standalone_puc_lua_5_4","project_zomboid_b41_41_78_20"]},
    "dialect_sensitive":{"type":"boolean"},
    "dialect_reasons":{"type":"array","items":{"type":"string"}},
    "evidence_role":{"enum":["auxiliary_standalone","runtime_behavior"]},
    "stubbed_dependencies":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": true
}

