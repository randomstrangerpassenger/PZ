{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iris-core-refactor-validation-asset-manifest-v1",
  "type": "object",
  "required": ["schema_version","generation","previous_manifest_sha256_or_null","expected_required_count","expected_required_asset_ids","expected_required_asset_ids_sha256","reserved_future_count","sealed","assets"],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {"type":"integer","minimum":1},
    "previous_manifest_sha256_or_null": {"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "expected_required_count": {"type":"integer","minimum":1},
    "expected_required_asset_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9._-]+$"}},
    "expected_required_asset_ids_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "reserved_future_count": {"type":"integer","minimum":0},
    "sealed": {"type":"boolean"},
    "assets": {
      "type":"array","minItems":1,
      "items": {
        "type":"object",
        "required":["asset_id","path","required","lifecycle_state","artifact_class","route_class_or_null","owner_change","tracked_required","clean_checkout_required"],
        "properties": {
          "asset_id":{"type":"string","pattern":"^[a-z0-9._-]+$"},
          "path":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"},
          "required":{"type":"boolean"},
          "lifecycle_state":{"enum":["reserved_future","required_active","sealed"]},
          "artifact_class":{"enum":["python_test","validation_support_asset","fixture","schema","evidence","binding_record","inventory","corpus","validator","ceiling"]},
          "route_class_or_null":{"type":["string","null"],"enum":["current","historical","diagnostic",null]},
          "owner_change":{"type":"integer","minimum":1,"maximum":9},
          "tracked_required":{"type":"boolean"},
          "clean_checkout_required":{"type":"boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
