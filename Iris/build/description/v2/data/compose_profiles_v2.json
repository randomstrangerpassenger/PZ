    "authority_ref": "docs/iris_dvf_shared_composition_usefulness_menu_tooltip_plan.md",
    "definitions": {
      "chopping": {
        "core": {
          "en": "Use it to {effect} {target}.",
          "ko": "{target} {effect}."
        },
        "menu_blocks": {}
      },
      "fuel_container": {
        "core": {
          "en": "Use it to carry {fuel} or {use}.",
          "ko": "{fuel}를 담아 운반하거나 {use} 수 있다."
        },
        "menu_blocks": {}
      },
      "melee_striking": {
        "core": {
          "en": "Use it to {effect}.",
          "ko": "{effect}."
        },
        "menu_blocks": {}
      },
      "open_can": {
        "core": {
          "en": "{action} with {opener} to take out the {contents}.",
          "ko": "{opener}로 {action} 안에 든 {contents} 꺼낼 수 있다."
        },
        "menu_blocks": {}
      },
      "portable_storage": {
        "core": {
          "en": "Use it to {use} items.",
          "ko": "물건을 {use} 수 있다."
        },
        "menu_blocks": {}
      },
      "skill_reading": {
        "core": {
          "en": "If {literacy} and have {skill} level {current_levels}, this book {xp_effect} for {skill} levels {trained_levels}.",
          "ko": "{literacy} {skill} 레벨이 {current_levels}라면, 이 책을 읽어 {skill} {trained_levels}레벨의 {xp_effect}."
        },
        "menu_blocks": {
          "progress": {
            "en": "The book has {pages} pages. Every 10% read applies the new multiplier only if it is higher, up to {multiplier} times when finished.",
            "ko": "총 {pages}쪽이며, 10%씩 읽을 때마다 현재보다 높은 배율만 적용된다. 끝까지 읽으면 최대 {multiplier}배가 된다."
          }
        }
      },
      "towel_uses": {
        "core": {
          "en": "If {dry_condition}, you can {dry_effect}. {clean_condition}, you can also {clean_effect}.",
          "ko": "{dry_condition}, {dry_effect}. {clean_condition}, {clean_effect}."
        },
        "menu_blocks": {}
      },
      "vehicle_panel": {
        "core": {
          "en": "You can {use} the vehicle's {target}.",
          "ko": "차량의 {target}를 {use}."
        },
        "menu_blocks": {}
      },
      "wearing": {
        "core": {
          "en": "You can {use} it {location}.",
          "ko": "{location} {use}."
        },
        "menu_blocks": {}
      }
