        "core": {
          "en": "{action} {opener} to obtain {contents}.",
          "ko": "{opener} {action} {contents} 꺼낼 수 있다."
        },
        "menu_blocks": {}
      },
      "portable_storage": {
        "core": {
          "en": "A {container} used to {use} items.",
          "ko": "물건을 {use} {container}이다."
        },
        "menu_blocks": {}
      },
      "skill_reading": {
        "core": {
          "en": "When {literacy} and your current {skill} level is {current_levels}, reading it {xp_effect} for {skill} levels {trained_levels}.",
          "ko": "{literacy} {skill}의 현재 레벨이 {current_levels}일 때 읽으면, {skill} {trained_levels}레벨 구간의 {xp_effect}."
        },
        "menu_blocks": {
          "progress": {
            "en": "The multiplier is calculated in 10% steps of its {pages} pages read and is updated only when higher than the existing multiplier. Its maximum when fully read is {multiplier} times.",
            "ko": "전체 {pages}쪽 중 읽은 비율을 10% 단위로 계산한 배율이 기존 배율보다 높을 때 갱신된다. 끝까지 읽었을 때의 최대 배율은 {multiplier}배다."
          }
        }
      },
      "towel_uses": {
        "core": {
          "en": "{dry_effect} {dry_condition}. {clean_effect} {clean_condition}.",
          "ko": "{dry_condition} {dry_effect}. {clean_condition} {clean_effect}."
        },
        "menu_blocks": {}
      },
