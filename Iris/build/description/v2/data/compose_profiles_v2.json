      "chopping": {
        "core": {
          "en": "Used to {effect} {target}.",
          "ko": "{target} {effect}."
        },
        "menu_blocks": {}
      },
      "fuel_container": {
        "core": {
          "en": "A container used to {use} {fuel}.",
          "ko": "{fuel}를 담아 {use} 용기다."
        },
        "menu_blocks": {}
      },
