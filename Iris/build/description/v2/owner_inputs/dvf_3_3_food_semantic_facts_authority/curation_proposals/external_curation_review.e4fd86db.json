  "findings": [
    {
      "finding_id": "CUR-EXT-I-001",
      "severity": "Important",
      "status": "open",
      "title": "Whitespace and blank approval metadata are accepted as explicit semantic approval",
      "affected_paths": [
        "Iris/build/description/v2/tools/build/dvf_3_3_food_semantic/curation_proposals.py",
        "Iris/build/description/v2/tests/test_dvf_3_3_food_semantic_curation_proposals.py"
      ],
      "affected_lines": {
        "validator": "883-890",
        "materializer": "1025-1069"
      },
      "contract_violation": "Change 8 and D6 prohibit anonymous or implicit approval and require an explicit approver, approval time, and rationale. Required approval metadata must fail closed, not merely have dictionary keys.",
      "technical_detail": "The validator checks required-key membership, then applies truthiness only to approver_identity. A whitespace-only identity is truthy, and approval_time and rationale are never checked for nonblank values or format. Exact proposal hashes and exact proposition/rework sets therefore allow semantically anonymous approval packets to pass.",
      "reproduction": {
        "fixture": {
          "approval_state": "approved",
          "approver_identity": "   ",
          "approval_time": "",
          "rationale": "",
          "proposal_content_sha256": "the exact stored per-batch hash",
          "approved_proposition_ids": "the exact complete per-batch set",
          "accepted_needs_rework_items": "the exact complete per-batch set"
        },
        "batch_count": 10,
        "validator_require_all_approved": true,
        "validator_exit_code": 0,
        "observed_status": "PASS",
        "observed_approved_batch_count": 10,
        "observed_approved_proposition_count": 236,
        "observed_acknowledged_rework_count": 2,
        "observed_invalid_batch_count": 0,
        "observed_blockers": []
      },
      "impact": "The subsequent materializer treats the whitespace identity as semantic_approver and emits accepted events with authority_effect=true for 236 curated propositions. This bypasses the required attributable human semantic approval.",
      "required_resolution": "Reject empty or whitespace-only approver_identity, approval_time, and rationale; validate approval_time as a nonblank accepted timestamp; add negative fixtures proving validation and materialization fail closed for blank, whitespace, anonymous, and missing metadata.",
      "authority_execution_gate_effect": "BLOCK"
    },
    {
      "finding_id": "CUR-EXT-I-002",
      "severity": "Important",
      "status": "open",
      "title": "Authority materialization accepts an unrestricted output root",
      "affected_paths": [
        "Iris/build/description/v2/tools/build/run_dvf_3_3_food_semantic_curation.py",
        "Iris/build/description/v2/tools/build/dvf_3_3_food_semantic/curation_proposals.py",
        "Iris/build/description/v2/tests/test_dvf_3_3_food_semantic_curation_proposals.py"
      ],
      "affected_lines": {
        "cli": "52-58",
        "materializer": "955-960, 1073-1114"
      },
      "contract_violation": "The plan and owner decisions prohibit current facts, manifest, rendered, Lua/runtime, and package mutation in this route. Authority-bearing output must be constrained to the authorized attempt-local successor execution surface.",
      "technical_detail": "The CLI resolves any supplied --authority-root and passes it directly to materialize_approved_curation. The materializer appends phase8_curation to that arbitrary root and writes five authority-bearing files without assert_attempt_output_root, assert_safe_writer_sink, a protected-root denylist, or an authorized-root allowlist.",
      "reproduction": {
        "static_call_path": "CLI --authority-root -> _resolve -> materialize_approved_curation -> authority_root/phase8_curation",
        "safe_sink_guard_call_count": 0,
        "attempt_root_guard_call_count": 0,
        "focused_protected_sink_negative_fixture_count": 0
      },
      "impact": "After otherwise valid approvals, an invocation can create authority artifacts beneath a protected current data, runtime, Lua, or package tree. Write-once byte behavior prevents later divergent rewrites but does not make the initial sink safe.",
      "required_resolution": "Constrain authority_root to the approved attempt-local/non-current authority execution root, explicitly reject current/protected roots, and add negative fixtures for current facts/data, rendered, Lua/runtime, and package sink targets.",
      "authority_execution_gate_effect": "BLOCK"
    }
  ],
