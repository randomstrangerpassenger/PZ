  "findings": [
    {
      "finding_id": "PHASE11-EXT-I-001",
      "severity": "important",
      "title": "Private fixture can bypass the external review gate at the canonical Phase 11 sink",
      "locations": [
        {
          "path": "Iris/build/description/v2/tools/build/dvf_3_3_food_semantic/authority_phase11.py",
          "line": 458,
          "symbol": "_require_phase11_output_sink"
        },
        {
          "path": "Iris/build/description/v2/tools/build/dvf_3_3_food_semantic/authority_phase11.py",
          "line": 1084,
          "symbol": "_materialize_authority_phase11_fixture"
        }
      ],
      "evidence": "The private materializer does not call _validate_phase11_external_implementation_review, while the shared sink validator explicitly accepts an output root named phase11_successor. With the canonical review absent, an independent no-write reproduction passed authority_root/phase11_successor to _materialize_authority_phase11_fixture; it produced a PASS result, built all 17 payloads, and reached _preflight_and_write. The write function was mocked, so no actual directory or artifact was created.",
      "impact": "Any caller able to import the module can materialize authoritative-looking canonical Phase 11 artifacts at the exact public sink without the required external implementation PASS. The public CLI is fail-closed, but the actual durable authority boundary is not exclusive to that gated path.",
      "required_remediation": "Make the fixture path temp-only and structurally unable to target phase11_successor. Separate the gated canonical materializer from the fixture materializer, require the fixture output name and location to be an existing p11-fixture-* temporary sink, and ensure only run_authority_phase11 can reach the canonical phase11_successor write path after validating the exact external review. Add a zero-write test that calls the private fixture with the canonical sink while the external review is absent and expects rejection."
    },
    {
      "finding_id": "PHASE11-EXT-I-002",
      "severity": "important",
      "title": "External implementation review is not bound to the reviewed commit",
      "locations": [
        {
          "path": "Iris/build/description/v2/tools/build/dvf_3_3_food_semantic/authority_phase11.py",
          "line": 1009,
          "symbol": "_validate_phase11_external_implementation_review"
        }
      ],
      "evidence": "The validator checks the exact three reviewed code file hashes and the other PASS fields but never reads reviewed_commit_sha. An independent synthetic review containing the exact current code identities and every required PASS field, but reviewed_commit_sha set to forty zeroes, was accepted unchanged. Changing one reviewed code hash was correctly rejected, isolating the missing commit check.",
      "impact": "The canonical Phase 11 gate can consume a review that does not attest to exact commit a03b4943672f838f3466d8ba5a5de3e8c73ae8ca, breaking the requested commit-level review chain and allowing misleading or stale commit provenance even when file hashes happen to match.",
      "required_remediation": "Introduce the exact reviewed implementation commit as a constant or otherwise sealed input and require review.reviewed_commit_sha to equal a03b4943672f838f3466d8ba5a5de3e8c73ae8ca. Add a test proving a wrong or missing reviewed_commit_sha blocks before any payload construction or write."
    }
  ],
