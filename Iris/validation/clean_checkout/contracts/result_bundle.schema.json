{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris.invalid/schemas/clean-checkout/canonical-result-v2",
  "title": "Iris Clean-Checkout Canonical Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "status",
    "subject",
    "canonical_gate_blob_id",
    "phase0_environment_binding_blob_id",
    "output_policy_blob_id",
    "normalized_command",
    "environment_verification",
    "pytest_version",
    "test_identity_count",
    "test_inventory_sha256",
    "identity_rows",
    "collection_error_count",
    "repository_clean_before",
    "repository_clean_after"
  ],
  "properties": {
    "schema_version": {
      "const": "iris-clean-checkout-canonical-result-v2"
    },
    "mode": {
      "enum": [
        "collect_only",
        "execute"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "subject": {
      "$ref": "#/$defs/git_identity"
    },
    "canonical_gate_blob_id": {
      "$ref": "#/$defs/sha1"
    },
    "phase0_environment_binding_blob_id": {
      "$ref": "#/$defs/sha1"
    },
    "output_policy_blob_id": {
      "$ref": "#/$defs/sha1"
    },
    "normalized_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "environment_verification": {
      "$ref": "#/$defs/environment_verification"
    },
    "pytest_version": {
      "type": "string",
      "minLength": 1
    },
    "test_identity_count": {
      "type": "integer",
      "minimum": 1
    },
    "test_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "identity_rows": {
      "type": "array",
      "minItems": 1
    },
    "collection_error_count": {
      "type": "integer",
      "minimum": 0
    },
    "repository_clean_before": {
      "type": "boolean"
    },
    "repository_clean_after": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "tree": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "environment_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "environment_receipt_sha256",
        "environment_content_manifest_sha256",
        "environment_file_count",
        "interpreter_sha256",
        "package_count",
        "package_set_sha256"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "environment_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_content_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "interpreter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_count": {
          "type": "integer",
          "minimum": 1
        },
        "package_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
